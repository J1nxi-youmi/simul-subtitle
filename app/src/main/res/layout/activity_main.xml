<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">

        <!-- header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@null"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="手机本地识别日语 · 实时中文字幕"
                    android:textColor="@color/text2"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- main card: status + primary action -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp" />

                    <TextView
                        android:id="@+id/statusTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textColor="@color/text"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/statusBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text2"
                    android:textSize="14sp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:max="1000"
                    android:visibility="gone"
                    app:indicatorColor="@color/brand"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/primary"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="18dp"
                    android:textSize="17sp"
                    app:cornerRadius="18dp"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/secondary"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- permissions -->
        <TextView
            style="@style/SectionTitle"
            android:text="权限" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="24dp">

            <LinearLayout
                android:id="@+id/permList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="6dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- translation, display mode, Jev -->
        <TextView
            style="@style/SectionTitle"
            android:text="翻译" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="24dp">

            <LinearLayout
                android:id="@+id/translateList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- session logs -->
        <TextView
            style="@style/SectionTitle"
            android:text="使用记录" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="24dp">

            <LinearLayout
                android:id="@+id/logList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- model files on disk -->
        <TextView
            style="@style/SectionTitle"
            android:text="模型文件" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="24dp">

            <LinearLayout
                android:id="@+id/modelFileList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- subtitle style -->
        <TextView
            style="@style/SectionTitle"
            android:text="字幕样式" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- live preview on a fake video frame -->
                <FrameLayout
                    android:id="@+id/previewStage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="150dp"
                    android:background="@drawable/preview_stage">

                    <FrameLayout
                        android:id="@+id/previewHolder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp" />
                </FrameLayout>

                <TextView
                    style="@style/SliderLabel"
                    android:text="字幕配色" />
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/paletteRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    style="@style/SliderLabel"
                    android:id="@+id/labelSize" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderSize"
                    app:tickVisible="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:valueFrom="12"
                    android:valueTo="36" />

                <TextView
                    style="@style/SliderLabel"
                    android:id="@+id/labelAlpha" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderAlpha"
                    app:tickVisible="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="5"
                    android:valueFrom="0"
                    android:valueTo="100" />

                <TextView
                    style="@style/SliderLabel"
                    android:id="@+id/labelWidth" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderWidth"
                    app:tickVisible="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="5"
                    android:valueFrom="40"
                    android:valueTo="100" />

                <TextView
                    style="@style/SliderLabel"
                    android:id="@+id/labelHeight" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderHeight"
                    app:tickVisible="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="5"
                    android:valueFrom="0"
                    android:valueTo="40" />

                <TextView
                    style="@style/SliderLabel"
                    android:id="@+id/labelKeepSentences" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderKeepSentences"
                    app:tickVisible="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:valueFrom="1"
                    android:valueTo="6" />

                <TextView
                    style="@style/SliderLabel"
                    android:id="@+id/labelKeepChars" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderKeepChars"
                    app:tickVisible="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="10"
                    android:valueFrom="0"
                    android:valueTo="300" />
                <TextView
                    android:id="@+id/keepHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text2"
                    android:textSize="12.5sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchJa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="同时显示日语原文"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="显示识别/翻译耗时"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetStyle"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="恢复默认" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- day / night -->
        <TextView
            style="@style/SectionTitle"
            android:text="外观" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="24dp">

            <LinearLayout
                android:id="@+id/themeBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- tips -->
        <TextView
            style="@style/SectionTitle"
            android:text="使用说明" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/tips_bg"
            android:lineSpacingExtra="5dp"
            android:padding="18dp"
            android:text="1. 点「开始字幕」，在系统弹窗里选择要翻译的 App（或整个屏幕）。\n2. 字幕悬浮在屏幕上：拖动移动位置，拖右下角圆点同时调整宽度和高度（左右改宽、上下改高），点一下字幕展开工具栏（字号、透明度、显示模式、锁定、停止）。\n3. 「边出边改」：灰色字是识别中的草稿，说完一句后变白定稿；「只看定稿」：只显示说完的句子。\n4. 部分 App（例如开启了版权保护的视频）不允许捕获声音，这时不会出字幕。\n5. 每次使用的识别、翻译和 Jev 原始记录保存在「使用记录」里，可以分享出去分析（不含声音和 key）。"
            android:textColor="@color/text2"
            android:textSize="13.5sp" />
    </LinearLayout>
</ScrollView>
