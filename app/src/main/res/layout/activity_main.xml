<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">

        <!-- ===== home page: what it does, one big button, the two language choices ===== -->
        <LinearLayout
            android:id="@+id/homePage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@null"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="把视频、直播里的日语和英语，实时变成字幕"
                    android:textColor="@color/text2"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- main card: status + primary action -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="14dp"
                        android:layout_height="14dp" />

                    <TextView
                        android:id="@+id/statusTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textColor="@color/text"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/statusBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/text2"
                    android:textSize="17sp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:max="1000"
                    android:visibility="gone"
                    app:indicatorColor="@color/brand"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="76dp"
                    android:layout_marginTop="20dp"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:iconSize="28dp"
                    app:cornerRadius="18dp"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    android:textColor="@color/on_brand"
                    app:iconTint="@color/on_brand" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/secondary"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginTop="4dp"
                    android:textSize="18sp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- permissions: shown on the home page only while a required one is missing -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/permCard"
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="12dp"
                    android:text="开始前，需要你允许下面两件事"
                    android:textColor="@color/text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/permList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- the two language choices -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="24dp">

            <LinearLayout
                android:id="@+id/langBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openSettings"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:layout_marginTop="16dp"
            android:text="字幕大小、颜色和更多设置"
            android:textSize="18sp"
            app:cornerRadius="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:lineSpacingExtra="3dp"
            android:paddingHorizontal="8dp"
            android:text="声音只在手机上识别，不会上传；用在线翻译时，会把识别出的文字发给翻译接口。"
            android:textColor="@color/text2"
            android:textSize="14sp" />
        </LinearLayout>

        <!-- ===== settings page ===== -->
        <LinearLayout
            android:id="@+id/settingsPage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/closeSettings"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="‹ 返回"
                android:textSize="18sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="设置"
                android:textColor="@color/text"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>
        <!-- subtitle style -->
        <TextView
            style="@style/SectionTitle"
            android:text="字幕样式" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- live preview on a fake video frame -->
                <FrameLayout
                    android:id="@+id/previewStage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="150dp"
                    android:background="@drawable/preview_stage">

                    <FrameLayout
                        android:id="@+id/previewHolder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp" />
                </FrameLayout>

                <TextView
                    style="@style/SliderLabel"
                    android:text="字幕配色" />
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/paletteRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    style="@style/SliderLabel"
                    android:id="@+id/labelSize" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderSize"
                    app:tickVisible="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:valueFrom="5"
                    android:valueTo="36" />

                <TextView
                    style="@style/SliderLabel"
                    android:id="@+id/labelAlpha" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderAlpha"
                    app:tickVisible="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="5"
                    android:valueFrom="0"
                    android:valueTo="100" />

                <TextView
                    style="@style/SliderLabel"
                    android:id="@+id/labelWidth" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderWidth"
                    app:tickVisible="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="5"
                    android:valueFrom="40"
                    android:valueTo="100" />

                <TextView
                    style="@style/SliderLabel"
                    android:id="@+id/labelHeight" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderHeight"
                    app:tickVisible="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="5"
                    android:valueFrom="0"
                    android:valueTo="40" />

                <TextView
                    style="@style/SliderLabel"
                    android:id="@+id/labelKeepSentences" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderKeepSentences"
                    app:tickVisible="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:valueFrom="1"
                    android:valueTo="6" />

                <TextView
                    style="@style/SliderLabel"
                    android:id="@+id/labelKeepChars" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderKeepChars"
                    app:tickVisible="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="10"
                    android:valueFrom="0"
                    android:valueTo="300" />
                <TextView
                    android:id="@+id/keepHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text2"
                    android:textSize="14sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchJa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="同时显示原文"
                    android:textColor="@color/text"
                    android:textSize="17sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="显示识别和翻译用时"
                    android:textColor="@color/text"
                    android:textSize="17sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetStyle"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="恢复默认" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- day / night -->
        <TextView
            style="@style/SectionTitle"
            android:text="页面颜色" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="24dp">

            <LinearLayout
                android:id="@+id/themeBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp" />
        </com.google.android.material.card.MaterialCardView>


        <!-- optional notification permission (Android 13+); the home permission card hides once the required two are granted -->
        <LinearLayout
            android:id="@+id/notifSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/SectionTitle"
                android:text="通知" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:id="@+id/notifList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="6dp" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- translation, display mode, Jev -->
        <TextView
            style="@style/SectionTitle"
            android:text="翻译" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="24dp">

            <LinearLayout
                android:id="@+id/translateList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- session logs -->
        <TextView
            style="@style/SectionTitle"
            android:text="使用记录" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="24dp">

            <LinearLayout
                android:id="@+id/logList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- model files on disk -->
        <TextView
            style="@style/SectionTitle"
            android:text="已下载的文件" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="24dp">

            <LinearLayout
                android:id="@+id/modelFileList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- tips -->
        <TextView
            style="@style/SectionTitle"
            android:text="使用说明" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/tips_bg"
            android:lineSpacingExtra="5dp"
            android:padding="18dp"
            android:text="1. 点首页的「开始字幕」，在弹出的窗口里选你要看的 App（也可以选整个屏幕）。\n2. 字幕会浮在屏幕上：按住拖动可以换位置，拖字幕框的右下角可以改大小。\n3. 点一下字幕会出现工具栏：调字号、调背景、切换显示方式、锁定位置，或者停止。\n4. 有些 App（比如有版权保护的视频）不允许其他 App 听它的声音，这时不会出字幕。同时有别的 App 在放声音时，它的声音也可能出现在字幕里。\n5. 每次使用都会留下一份文字记录（不含声音和 key），可以在「使用记录」里分享出去，帮助反馈问题。"
            android:textColor="@color/text2"
            android:textSize="15sp" />

        <!-- about -->
        <TextView
            style="@style/SectionTitle"
            android:text="关于" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/aboutVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text"
                    android:textSize="16sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/autoUpdate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginTop="12dp"
                    android:text="自动检查更新"
                    android:textColor="@color/text"
                    android:textSize="17sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/checkUpdate"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:text="检查更新"
                    android:textSize="17sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openRepo"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginTop="12dp"
                    android:text="GitHub 项目主页"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="https://github.com/KorenKrita/simul-subtitle"
                    android:textColor="@color/text2"
                    android:textIsSelectable="true"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="3dp"
                    android:text="翻译用的是 B 站开源的 Index-Translate 模型（github.com/bilibili/Index-Translate），语音识别用的是 ReazonSpeech 模型（通过 sherpa-onnx 在手机上运行）。感谢这些项目。"
                    android:textColor="@color/text2"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
